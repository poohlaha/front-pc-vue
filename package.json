{
  "name": "front-pc-vue",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/poohlaha/front-pc-vue.git",
  "engines": {
    "node": ">=16.0.0"
  },
  "description": "`Vue` `PC` 端框架模块.",
  "keywords": [
    "vue",
    "css",
    "js"
  ],
  "author": "poohlaha",
  "license": "MIT/Apache-2.0",
  "scripts": {
    "start": "node ./scripts/build.js start",
    "dev": "rimraf build && node ./scripts/build.js build",
    "simulate": "rimraf build && node ./scripts/build.js simulate",
    "prod": "rimraf dist && node ./scripts/build.js prod",
    "format": "npx prettier --write src",
    "report": "jscpd --pattern 'src/views/**/*.{vue,ts,js}'",
    "updater": "node ./scripts/updater.js"
  },
  "dependencies": {
    "lib-flexible": "^0.3.2",
    "axios": "^0.21.1",
    "crypto-js": "^4.1.1",
    "fastclick": "^1.0.6",
    "vue": "2.7.14",
    "vue-router": "^3.5.4",
    "vuex": "^3.6.2",
    "vant": "2.12.54"
  },
  "devDependencies": {
    "@bale-tools/mutate-service": "^2.3.7",
    "@bale-tools/mutate-version": "^2.2.8",
    "@bale-tools/mutate-minimize": "^1.0.6",
    "vue-loader": "^15.11.1",
    "@bale-tools/utils": "^2.0.7",
    "babel-eslint": "^10.1.0",
    "@babel/eslint-parser": "^7.25.9",
    "toml": "^3.0.0",
    "jscpd": "^4.0.5",
    "core-js": "^3.8.3",
    "lib-flexible": "^0.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "lint-staged": "^15.2.10",
    "babel-plugin-import": "^1.13.3",
    "@commitlint/cli": "^19.6.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/eslint-config-standard": "^5.1.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "vue-template-compiler": "2.7.14",
    "postcss-aspect-ratio-mini": "^1.1.0",
    "postcss-write-svg": "^3.0.1",
    "n-readlines": "^1.0.1",
    "rimraf": "^5.0.1",
    "@babel/core": "^7.26.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8",
    "iOS >= 8",
    "Firefox >= 20",
    "Android > 4.4"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "**/*.{vue,jsx,js,tsx,ts,json,css,md}": [
      "prettier --write"
    ],
    "**/*.{vue,jsx,js,tsx,ts}": [
      "eslint --fix"
    ]
  }
}
